rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'oluwatoyinishola2024@gmail.com' && request.auth.token.email_verified == true)
      );
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }

    function isValidSiteSetting(data) {
      return data is map
        && data.keys().size() <= 30
        && (!('branding' in data) || data.branding is map)
        && (!('hero' in data) || data.hero is map)
        && (!('statsSection' in data) || data.statsSection is map)
        && (!('aboutSection' in data) || data.aboutSection is map)
        && (!('coreValues' in data) || data.coreValues is map)
        && (!('ceoSection' in data) || data.ceoSection is map)
        && (!('eventsSection' in data) || data.eventsSection is map)
        && (!('teamSection' in data) || data.teamSection is map)
        && (!('blogSection' in data) || data.blogSection is map)
        && (!('reviewsSection' in data) || data.reviewsSection is map)
        && (!('bookingSection' in data) || data.bookingSection is map)
        && (!('staffMail' in data) || data.staffMail is map)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidMailbox(data) {
      return data is map
        && data.keys().hasAll(['email', 'name', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidMessage(data) {
      return data is map
        && data.keys().hasAll(['mailboxId', 'from', 'subject', 'receivedAt'])
        && data.mailboxId is string && data.mailboxId.size() >= 1 && data.mailboxId.size() <= 200
        && data.from is string && data.from.size() >= 1 && data.from.size() <= 300
        && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 500
        && data.receivedAt is string && data.receivedAt.size() <= 64
        && (!('body' in data) || (data.body is string && data.body.size() <= 20000));
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /site_settings/{settingId} {
      allow get: if settingId == 'main';
      allow write: if isSignedIn() && isValidId(settingId) && isValidSiteSetting(incoming());
    }

    match /mailboxes/{mailboxId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(mailboxId) && isValidMailbox(incoming());
      allow delete: if isSignedIn() && isValidId(mailboxId);
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isSignedIn() && isValidId(messageId);
    }

    match /emails/{emailId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
