rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // HELPER FUNCTIONS
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'jerryoyedele@cleadglobal.org') ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'oluwatoyinishola2024@gmail.com')
      );
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }

    function isValidAdminDoc(data) {
      return data is map
        && data.keys().size() <= 10
        && ('uid' in data && data.uid is string && data.uid.size() <= 128)
        && ('email' in data && data.email is string && data.email.size() <= 200);
    }

    function isValidSiteSetting(data) {
      return data is map
        && data.keys().size() <= 30
        && (!('branding' in data) || data.branding is map)
        && (!('hero' in data) || data.hero is map)
        && (!('statsSection' in data) || data.statsSection is map)
        && (!('aboutSection' in data) || data.aboutSection is map)
        && (!('coreValues' in data) || data.coreValues is map)
        && (!('ceoSection' in data) || data.ceoSection is map)
        && (!('eventsSection' in data) || data.eventsSection is map)
        && (!('teamSection' in data) || data.teamSection is map)
        && (!('blogSection' in data) || data.blogSection is map)
        && (!('reviewsSection' in data) || data.reviewsSection is map)
        && (!('bookingSection' in data) || data.bookingSection is map)
        && (!('staffMail' in data) || data.staffMail is map)
        && (!('customPages' in data) || data.customPages is list)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /admins/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'jerryoyedele@cleadglobal.org') ||
        (request.auth.token.email is string && request.auth.token.email.lower() == 'oluwatoyinishola2024@gmail.com')
      ) && isValidAdminDoc(incoming());
      allow delete: if isAdmin();
    }

    match /site_settings/{settingId} {
      allow get: if settingId == 'main';
      allow write: if isAdmin() && isValidSiteSetting(incoming());
    }

    match /mailboxes/{mailboxId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
    
    match /messages/{messageId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /emails/{emailId} {
      allow get: if isSignedIn() && (resource.data.mailboxId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow write: if false;
    }
  }
}