{
  "entities": {
    "SiteSetting": {
      "title": "SiteSetting",
      "description": "Global website configuration, sections, and staff mail directory for Champions Leadership Global.",
      "type": "object",
      "properties": {
        "branding": {
          "type": "object",
          "description": "Organization branding, contact details, and social media links."
        },
        "hero": {
          "type": "object",
          "description": "Homepage hero banner content and call-to-action settings."
        },
        "statsSection": {
          "type": "object",
          "description": "Impact metrics and statistics displayed on the website."
        },
        "aboutSection": {
          "type": "object",
          "description": "About Us, mission, vision, and organization story."
        },
        "coreValues": {
          "type": "object",
          "description": "Core values and guiding principles."
        },
        "ceoSection": {
          "type": "object",
          "description": "Founder & CEO profile, biography, and speaking information."
        },
        "eventsSection": {
          "type": "object",
          "description": "Upcoming and past leadership events and summits."
        },
        "teamSection": {
          "type": "object",
          "description": "Executive team members and global volunteers."
        },
        "blogSection": {
          "type": "object",
          "description": "Published leadership articles and blog posts."
        },
        "reviewsSection": {
          "type": "object",
          "description": "Testimonials and participant reviews."
        },
        "bookingSection": {
          "type": "object",
          "description": "Booking and contact inquiry configuration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the last content update.",
          "maxLength": 64
        }
      }
    },
    "Mailbox": {
      "title": "Mailbox",
      "description": "A staff email account/mailbox.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 200 },
        "name": { "type": "string", "maxLength": 200 },
        "fullName": { "type": "string", "maxLength": 200 },
        "role": { "type": "string", "maxLength": 200 },
        "department": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 200 },
        "quota": { "type": "string", "maxLength": 64 },
        "used": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["email", "name", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message within a mailbox.",
      "type": "object",
      "properties": {
        "mailboxId": { "type": "string", "maxLength": 200 },
        "folder": { "type": "string", "maxLength": 64 },
        "from": { "type": "string", "maxLength": 300 },
        "fromEmail": { "type": "string", "maxLength": 200 },
        "to": { "type": "string", "maxLength": 200 },
        "subject": { "type": "string", "maxLength": 500 },
        "body": { "type": "string", "maxLength": 20000 },
        "date": { "type": "string", "maxLength": 64 },
        "receivedAt": { "type": "string", "maxLength": 64 },
        "read": { "type": "boolean" },
        "starred": { "type": "boolean" }
      },
      "required": ["mailboxId", "from", "subject", "receivedAt"]
    },
    "Email": {
      "title": "Email",
      "description": "Inbound emails received via Resend webhooks.",
      "type": "object",
      "properties": {
        "mailboxId": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "subject": { "type": "string" },
        "html": { "type": "string" },
        "text": { "type": "string" },
        "receivedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "mailboxId",
        "from",
        "to",
        "subject",
        "receivedAt"
      ]
    }
  },
  "firestore": {
    "/site_settings/{settingId}": {
      "schema": "SiteSetting",
      "description": "Stores the live website content document (settingId = 'main') synced across all clients."
    },
    "/mailboxes/{mailboxId}": {
      "schema": "Mailbox",
      "description": "Staff mailboxes."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages for a mailbox."
    },
    "/emails/{emailId}": {
      "schema": "Email",
      "description": "Inbound emails."
    }
  }
}
